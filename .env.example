# Public endpoint
VIPIN_DOMAIN=vpn.example.com
VIPIN_CONTACT_EMAIL=admin@example.com

# Docker images (pin tags on production VPS)
XRAY_IMAGE=ghcr.io/xtls/xray-core
XRAY_IMAGE_TAG=latest
HYSTERIA_IMAGE=tobyxdd/hysteria
HYSTERIA_IMAGE_TAG=latest
CADDY_IMAGE=caddy
CADDY_IMAGE_TAG=2-alpine

# Xray REALITY over TCP/443
XRAY_PORT=443
ACME_PORT=80
FALLBACK_ADDR=caddy:8080
XRAY_CLIENT_UUID=replace-with-uuid
XRAY_REALITY_PRIVATE_KEY=replace-with-xray-private-key
XRAY_REALITY_PUBLIC_KEY=replace-with-xray-public-key
XRAY_REALITY_SHORT_ID=replace-with-short-id
XRAY_REALITY_SERVER_NAME=www.cloudflare.com
XRAY_REALITY_DEST=www.cloudflare.com:443

# Hysteria2 over UDP/443
HYSTERIA_PORT=443
HYSTERIA_PASSWORD=replace-with-hysteria-password
HYSTERIA_OBFS_PASSWORD=replace-with-hysteria-obfs-password
HYSTERIA_MASQUERADE_URL=https://www.cloudflare.com/
HYSTERIA_INSECURE=0

# Co-resident services on the same VPS (optional)
# MTProto cannot share 443/tcp with Xray if both bind the same host port.
# Set the real mtproto TCP port here after checking diagnose-host.sh output.
MTPROTO_PORT=8443
WG_PORT=51820
# VIPIN_EXTRA_TCP_PORTS=8443
# VIPIN_EXTRA_UDP_PORTS=

